# Copy to .env and adjust. Every backend setting is listed in backend/app/config.py.

# Web UI port on the host.
YUI_PORT=8080

# "yue2" = real model (NVIDIA GPU, ~24 GB VRAM), "mock" = synthetic tone, for UI work without GPU.
YUI_ENGINE=yue2
# Build the image without YuE2/PyTorch (mock-only machines). Must be "true" for YUI_ENGINE=yue2.
INSTALL_YUE=true
YUI_MODEL_ID=m-a-p/YuE2-3B
YUI_DEVICE=cuda

# Check GitHub releases at every start and upgrade YuE2 when a newer one exists.
YUI_AUTO_UPDATE=true
# Pin a release instead of tracking the latest one (recommended once you are happy with a version).
# YUI_YUE_PINNED_TAG=yue2-v0.1.6

# The first account becomes admin. Turn this off after creating your users.
YUI_ALLOW_REGISTRATION=true
# Set to true when exposed over HTTPS (reverse proxy with TLS).
YUI_COOKIE_SECURE=false
