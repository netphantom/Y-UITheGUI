# Y-UI configuration. Copy to .env (install.sh does it for you) and restart after changes:
#   docker compose up -d
# Every backend option is documented in backend/app/config.py.

# --- Deployment ----------------------------------------------------------------
# Compose files to combine (":" separated). Drop docker-compose.gpu.yml on machines without
# an NVIDIA GPU, add docker-compose.dev.yml to build the images from source.
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# Image tag: "latest" (main branch) or a release such as "1.0.0".
YUI_VERSION=latest
# Web UI address. Use 127.0.0.1 to keep it local behind a reverse proxy.
YUI_BIND=0.0.0.0
YUI_PORT=8080
# Host folder with the database, songs and model files (needs ~20 GB for YuE2).
YUI_DATA_PATH=./data
# Major number of /dev/nvidia-uvm on this host (`ls -l /dev/nvidia-uvm`).
NVIDIA_UVM_MAJOR=509

# --- Engine --------------------------------------------------------------------
# "yue2" = real model (NVIDIA GPU with BF16, ~24 GB VRAM); "mock" = synthetic tone, no GPU.
YUI_ENGINE=yue2
YUI_MODEL_ID=m-a-p/YuE2-3B
YUI_DEVICE=cuda
# Check GitHub releases at every start and upgrade YuE2 when a newer one exists.
YUI_AUTO_UPDATE=true
# Pin a release instead of tracking the latest one, e.g. yue2-v0.1.6.
YUI_YUE_PINNED_TAG=

# --- Accounts & security -------------------------------------------------------
# The first account becomes admin. Set to false once your users are created.
YUI_ALLOW_REGISTRATION=true
# Set to true when served over HTTPS (reverse proxy with TLS).
YUI_COOKIE_SECURE=false
